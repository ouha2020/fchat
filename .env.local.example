NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase 新版 API key（推荐，名字以 sb_publishable_ 开头）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# 或者旧版 anon key（任选其一即可）
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only key for Next.js API routes. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# PWA Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Family code email delivery (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM="Family Chat <noreply@example.com>"
# Server-only approved family creators, separated by commas. Empty means signup is closed.
# Family members still join with a family code; existing owner login is unaffected.
FAMILY_REGISTRATION_ALLOWED_EMAILS=

# Scheduled retries/reminders. Use independent random values; never NEXT_PUBLIC_.
PUSH_FLUSH_SECRET=
SCHEDULE_REMINDER_SECRET=
# CRON_SECRET is an alternative to SCHEDULE_REMINDER_SECRET for the reminder route.
CRON_SECRET=

# Platform maintenance only. Used by /admin/system-health and never exposed publicly.
SYSTEM_HEALTH_SECRET=change-me-to-a-long-random-secret
